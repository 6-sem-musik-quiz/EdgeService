{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "PermitLimit": 100,
    "IpCeiling": 1000,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "userservice": {
        "ClusterId": "userservice",
        "RateLimiterPolicy": "per-ip",
        "Match": {
          "Path": "/api/userservice/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**rest}"
          }
        ]
      },
      "lobbyservice": {
        "ClusterId": "lobbyservice",
        "RateLimiterPolicy": "per-ip",
        "Match": {
          "Path": "/api/lobbyservice/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**rest}"
          }
        ]
      },
      "gameservice": {
        "ClusterId": "gameservice",
        "RateLimiterPolicy": "per-ip",
        "Match": {
          "Path": "/api/gameservice/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**rest}"
          }
        ]
      },
      "musicservice": {
        "ClusterId": "musicservice",
        "RateLimiterPolicy": "per-ip",
        "Match": {
          "Path": "/api/musicservice/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**rest}"
          }
        ]
      },
      "statisticservice": {
        "ClusterId": "statisticservice",
        "RateLimiterPolicy": "per-ip",
        "Match": {
          "Path": "/api/statisticservice/{**rest}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**rest}"
          }
        ]
      }
    },
    "Clusters": {
      "userservice": {
        "Destinations": {
          "d1": {
            "Address": "http://userservice:8080/"
          }
        }
      },
      "lobbyservice": {
        "Destinations": {
          "d1": {
            "Address": "http://lobbyservice:8080/"
          }
        }
      },
      "gameservice": {
        "Destinations": {
          "d1": {
            "Address": "http://gameservice:8080/"
          }
        }
      },
      "musicservice": {
        "Destinations": {
          "d1": {
            "Address": "http://musicservice:8080/"
          }
        }
      },
      "statisticservice": {
        "Destinations": {
          "d1": {
            "Address": "http://statisticservice:8080/"
          }
        }
      }
    }
  }
}
