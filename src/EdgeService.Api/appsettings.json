{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 10
  },
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "userservice",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/users/{**rest}" }
      },
      "lobbies": {
        "ClusterId": "lobbyservice",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/lobbies/{**rest}" }
      },
      "games": {
        "ClusterId": "gameservice",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/games/{**rest}" }
      },
      "tracks": {
        "ClusterId": "musicservice",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/tracks/{**rest}" }
      },
      "statistics": {
        "ClusterId": "statisticservice",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/api/statistics/{**rest}" }
      },
      "lobby-hub": {
        "ClusterId": "lobbyservice",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/hubs/lobby/{**rest}" }
      },
      "game-hub": {
        "ClusterId": "gameservice",
        "RateLimiterPolicy": "per-ip",
        "Match": { "Path": "/hubs/game/{**rest}" }
      }
    },
    "Clusters": {
      "userservice": { "Destinations": { "d1": { "Address": "http://userservice:8080/" } } },
      "lobbyservice": { "Destinations": { "d1": { "Address": "http://lobbyservice:8080/" } } },
      "gameservice": { "Destinations": { "d1": { "Address": "http://gameservice:8080/" } } },
      "musicservice": { "Destinations": { "d1": { "Address": "http://musicservice:8080/" } } },
      "statisticservice": { "Destinations": { "d1": { "Address": "http://statisticservice:8080/" } } }
    }
  }
}
